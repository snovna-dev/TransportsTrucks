# Debe coincidir con el URI autorizado en Google Cloud Console, p. ej.:
# http://localhost:3000/api/google/drive/callback
GOOGLE_OAUTH_REDIRECT_URI=""
# Se obtiene visitando /api/google/drive/authorize con GOOGLE_OAUTH_SETUP_ENABLED=true.
GOOGLE_OAUTH_REFRESH_TOKEN=""
GOOGLE_OAUTH_SETUP_ENABLED="false"

# Alternativa: cuenta de servicio (solo funciona con una unidad compartida).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Pub/Sub (solo si PROCESSING_MODE=pubsub) ---
GOOGLE_CLOUD_PROJECT_ID="mi-proyecto-510005"
PUBSUB_MANIFEST_TOPIC="manifest-processing"
# Secreto compartido con la suscripción push: .../api/manifest-jobs/worker?token=WORKER_SECRET
WORKER_SECRET=""

# Conexiones máximas a PostgreSQL por proceso (Clever Cloud dev permite ~5 en total).
DATABASE_POOL_MAX="2"
