# Copie este archivo como .env.local y complete los valores.
# En Netlify, cargue las mismas variables en Site configuration > Environment variables.

# --- Base de datos (obligatoria) ---
# PostgreSQL de Clever Cloud. Después de cambiar el schema: npx prisma db push && npx prisma generate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/transportstrucks?schema=public"

# --- Procesamiento ---
# sync (recomendado): el PDF se procesa en la misma petición del cargue.
# pubsub: se publica { jobId } en Pub/Sub y un push a /api/manifest-jobs/worker lo procesa.
PROCESSING_MODE="sync"
# Tamaño máximo del PDF en MB. Netlify no acepta cuerpos de más de ~4.5 MB.
MAX_UPLOAD_MB="4"

# --- Almacenamiento del PDF original ---
# db (recomendado por ahora): se guarda en la tabla manifest_jobs.
# local: carpeta en disco (solo desarrollo; en Netlify el disco es efímero).
# drive: Google Drive.
STORAGE_PROVIDER="db"
STORAGE_LOCAL_DIR="storage/manifests"

# --- Google Drive con OAuth de la cuenta personal (STORAGE_PROVIDER=drive) ---
